# Azure OpenAI connection (either naming works; the first found is used)
endpoint=https://YOUR-RESOURCE.openai.azure.com/
api key=YOUR-AZURE-OPENAI-KEY
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=YOUR-AZURE-OPENAI-KEY

# Name of the model deployment inside that Azure OpenAI resource
# Chat deployments available in this resource: gpt-5.1, gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
# Leave unset to use the version-less v1 API (recommended). Set only if you
# need the legacy /openai/deployments/... path, e.g. 2024-10-21
# AZURE_OPENAI_API_VERSION=

# Where the web server listens. 0.0.0.0 makes it reachable from other
# devices on the same network (e.g. your phone).
HOST=0.0.0.0
PORT=3000
