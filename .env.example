# --- Azure OpenAI ------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR-AZURE-OPENAI-KEY
# (the names `endpoint` and `api key` are accepted too)

# Chat model used to answer
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
# Cheaper model OpenViking uses to summarise documents and extract memories
AZURE_OPENAI_PROCESSING_DEPLOYMENT=gpt-5.4-mini
# Embedding deployment OpenViking uses for search
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSION=3072
# Leave unset to use the version-less v1 chat API (recommended)
# AZURE_OPENAI_API_VERSION=

# --- OpenViking (context database: memory + documents) -----------------------
# In the Docker image OpenViking runs inside the container and these default to
# http://127.0.0.1:1933 and a generated key. Point OPENVIKING_URL elsewhere to
# use an existing OpenViking server, or set OPENVIKING_DISABLED=1 to run
# without memory and documents.
# OPENVIKING_URL=http://127.0.0.1:1933
# OPENVIKING_API_KEY=
# OPENVIKING_USER=default
# Seconds of quiet before a chat's memories are extracted (ms)
# OPENVIKING_EXTRACT_DELAY_MS=90000

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# Chat transcripts live here (a subfolder of the persistent disk in Docker)
# DATA_DIR=./data
