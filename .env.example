# ---- Agent LLM (LangChain provider:model string) ------------------------------
# Default: Claude Opus 5 through langchain-anthropic. Any init_chat_model provider works,
# e.g. openai:gpt-4o (requires the matching API key below).
AGENT_MODEL=anthropic:claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...          # also used by OpenViking below unless OV_* keys are set

# ---- Azure OpenAI (alternative to the two keys above) -------------------------------
# Chat: AGENT_MODEL=azure_openai:<chat-deployment-name>. langchain-openai reads the endpoint and
# key from these variables; the API version defaults to 2025-01-01-preview if unset.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# OPENAI_API_VERSION=2025-01-01-preview
# OpenViking: set the providers to "azure" and the models to your *deployment* names. Endpoint,
# key and version fall back to the AZURE_OPENAI_* / OPENAI_API_VERSION variables above.
# OV_EMBEDDING_PROVIDER=azure
# OV_EMBEDDING_MODEL=<embedding-deployment-name>     # e.g. text-embedding-3-small deployment
# OV_EMBEDDING_DIMENSION=1536
# OV_VLM_PROVIDER=azure
# OV_VLM_MODEL=<vision-chat-deployment-name>          # e.g. gpt-4o-mini deployment

# ---- Backend ---------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
ALLOW_REGISTRATION=true
# OPENVIKING_URL=http://localhost:1933   # compose overrides this to the openviking service
OPENVIKING_ACCOUNT=default

# ---- OpenViking server (docker/openviking/entrypoint.py builds ov.conf from these) ----
# Required. Shared secret between the backend and the OpenViking server (generate with
# `openssl rand -hex 32`). The server runs in "trusted" auth mode: it checks this key and then
# scopes every request to the X-OpenViking-User header the backend sets for the logged-in user.
OPENVIKING_ROOT_API_KEY=replace-with-a-long-random-string
OV_EMBEDDING_PROVIDER=openai
OV_EMBEDDING_MODEL=text-embedding-3-small
OV_EMBEDDING_DIMENSION=1536
OV_EMBEDDING_API_BASE=https://api.openai.com/v1
# OV_EMBEDDING_API_KEY=            # defaults to OPENAI_API_KEY (AZURE_OPENAI_API_KEY for provider=azure)
# OV_EMBEDDING_API_VERSION=        # Azure only; defaults to OPENAI_API_VERSION
OV_VLM_PROVIDER=openai
OV_VLM_MODEL=gpt-4o-mini
OV_VLM_API_BASE=https://api.openai.com/v1
# OV_VLM_API_KEY=                  # defaults to OPENAI_API_KEY (AZURE_OPENAI_API_KEY for provider=azure)
# OV_VLM_API_VERSION=              # Azure only; defaults to OPENAI_API_VERSION
# OV_CONF_PATH=/config/custom-ov.conf   # mount your own ov.conf instead of generating one

# ---- Ports -------------------------------------------------------------------------
UI_PORT=8080
BACKEND_PORT=8000
OPENVIKING_PORT=1933
